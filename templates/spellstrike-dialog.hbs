<form class="standard-form">
    <div>
        <a class="content-link" draggable="true" aria-label="Ability Item" data-link="" data-uuid="Item.PH8Ly3q26wStp5Ha" data-id="PH8Ly3q26wStp5Ha" data-type="Item" data-tooltip="" style=""><i class="fa-solid fa-suitcase" inert=""></i>Spellstrike</a>
    </div>
    <div class="ss-selector-row">
        <label for="weapon">Weapon:</label>
        <select id="weapon" name="weapon" type="dropdown">
            {{selectOptions weaponOptions selected=selectedWeapon valueAttr="id" labelAttr="label" localize=true}}
        </select>

        <label for="power">Power:</label>
        <select id="power" name="power" type="dropdown">
            {{selectOptions powerOptions selected=selectedPower valueAttr="id" labelAttr="label" localize=true}}
        </select>
    </div>
    <footer class="form-footer">
        <button type="button" data-action="confirm" {{#unless canConfirm}}disabled{{/unless}}>{{localize "Confirm"}}</button>
        <button type="button" data-action="cancel">{{localize "Cancel"}}</button>
    </footer>
</form>